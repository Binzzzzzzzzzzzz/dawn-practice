<div class="promo-banner" style="background-color: {{ section.settings.bg_color }}; padding: 20px; text-align: center;">
  <h2>{{ section.settings.heading }}</h2>
  <p>{{ section.settings.subtext }}</p>
</div>

{% schema %}
{
  "name": "Promo Banner",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Big Sale Today!"
    },
    {
      "type": "text",
      "id": "subtext",
      "label": "Subtext",
      "default": "Use code SAVE20 at checkout"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#ffcc00"
    }
  ],
  "presets": [
    {
      "name": "Promo Banner"
    }
  ]
}
{% endschema %}